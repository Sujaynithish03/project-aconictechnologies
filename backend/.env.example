# ---- Database -------------------------------------------------------------
# Local (docker-compose): postgresql+psycopg://kb:kb@localhost:5432/knowledge_base
# Neon: postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/knowledge_base

# ---- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- LLM ------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Deployment mode ------------------------------------------------------
# Hand the embedding phase to a background task instead of running it inline.
# Only safe on a long-running server (Docker/Render). Serverless hosts freeze
# the process after the response, so leave this false there.
DEFER_EMBEDDING=false
# Create the schema on startup. Set false on serverless and run
# `python scripts/init_db.py` once instead of on every cold start.
AUTO_INIT_DB=true

# ---- Uploads / RAG tuning -------------------------------------------------
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
